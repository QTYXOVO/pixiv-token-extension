{
  "manifest_version": 3,
  "name": "Pixiv Token 获取器",
  "version": "1.2.0",
  "description": "通过 pixiv 官方 OAuth 流程登录，获取 access_token / refresh_token 与 Web 端 Cookie，并可一键复制、刷新。",
  "permissions": ["webRequest", "tabs", "storage", "cookies"],
  "host_permissions": ["*://*.pixiv.net/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pixiv Token 获取器",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
